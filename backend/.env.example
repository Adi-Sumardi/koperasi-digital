APP_NAME="Koperasi Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=koperasi_digital
DB_USERNAME=kopkar_user
DB_PASSWORD=kopkar_secret

SESSION_DRIVER=redis
# Sesi hanya dipakai kanal Web Admin (Pengurus/Superadmin); anggota mobile pakai
# token Sanctum. 30 menit sesuai rules/security.md §1 (Inactivity Session Timeout).
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO / S3-compatible object storage (lihat docker-compose.yml)
AWS_ACCESS_KEY_ID=kopkar_minio
AWS_SECRET_ACCESS_KEY=kopkar_minio_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=koperasi-digital
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_URL=http://127.0.0.1:9000/koperasi-digital
AWS_USE_PATH_STYLE_ENDPOINT=true

MINIO_ROOT_USER=kopkar_minio
MINIO_ROOT_PASSWORD=kopkar_minio_secret

VITE_APP_NAME="${APP_NAME}"
